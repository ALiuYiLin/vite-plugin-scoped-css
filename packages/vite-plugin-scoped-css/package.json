{
  "name": "vite-plugin-scoped-css",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vue-like scoped CSS for React — compile-time CSS isolation",
  "exports": {
    ".": {
      "types": "./src/types.d.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
